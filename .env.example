# Copy to .env and replace every placeholder before starting the stack.
APP_VERSION=local
APP_DOMAIN=crm.example.org
ACME_EMAIL=ops@example.org

POSTGRES_DB=donor_crm
# Bootstrap administrator used only by PostgreSQL initialization and db-bootstrap.
POSTGRES_USER=donor_crm_admin
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-password

# Separate least-privilege application and migration roles. Use URL-safe random passwords.
APP_DB_USER=donor_crm_app
APP_DB_PASSWORD=replace-with-a-long-random-app-password
MIGRATION_USER=donor_crm_migrator
MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
DATABASE_URL=postgresql://donor_crm_app:replace-with-a-long-random-app-password@postgres:5432/donor_crm
MIGRATION_DATABASE_URL=postgresql://donor_crm_migrator:replace-with-a-long-random-migration-password@postgres:5432/donor_crm

# Session cookies are signed with this app secret; generate at least 32 random bytes.
SESSION_SECRET=replace-with-a-different-32-byte-session-secret
EMAIL_SIGNING_SECRET=replace-with-another-distinct-32-byte-email-token-secret

# Use at least 32 random bytes. This key signs short-lived app download URLs.
FILE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
JOB_SIGNING_SECRET=replace-with-a-different-32-byte-random-secret
# Required before storing tenant provider credentials. Generate with: openssl rand -base64 32
CREDENTIAL_VAULT_KEY_ID=primary
CREDENTIAL_VAULT_KEY=
# Optional multi-key rotation map, e.g. {"old":"<base64>","primary":"<base64>"}; key IDs must be quoted.
CREDENTIAL_VAULT_KEYRING=
# Optional: Stripe Connect platform key used server-side for already-authorized connected accounts.
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_CONNECT_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional SES v2 credentials; prefer short-lived IAM credentials in production.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_FROM_ADDRESS=
# Exact SNS topic ARN used by SES configuration-set event publishing. Leave unset to reject SES webhooks.
SES_SNS_TOPIC_ARN=
# In production, configure an isolated private ClamAV daemon or file uploads fail closed.
CLAMAV_HOST=
CLAMAV_PORT=3310
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4

# Shared-host public demo only: use a key distinct from the real application.
DEMO_SESSION_SECRET=
