{
	"name": "donor-crm",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build && node scripts/build-worker.mjs",
		"preview": "vite preview --host 0.0.0.0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"worker": "node build/worker.js",
		"smoke:worker": "npm run build:worker && node scripts/worker-smoke.mjs",
		"test:db": "node scripts/test-db.mjs",
		"themes:generate": "node scripts/themes.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"api:generate": "tsx scripts/openapi.ts",
		"build:worker": "node scripts/build-worker.mjs",
		"test:browser:db": "playwright test --config playwright.db.config.ts"
	},
	"dependencies": {
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@stripe/stripe-js": "10.1.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@tailwindcss/vite": "4.3.1",
		"argon2": "0.44.0",
		"bullmq": "5.81.5",
		"drizzle-orm": "0.45.4",
		"fast-xml-parser": "5.11.2",
		"ioredis": "5.9.3",
		"lucide-svelte": "0.577.0",
		"papaparse": "5.5.3",
		"pg": "8.16.3",
		"qrcode": "1.5.4",
		"stripe": "20.4.1",
		"svelte": "5.57.2",
		"tailwindcss": "4.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.58.2",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/node": "25.3.0",
		"@types/papaparse": "5.5.2",
		"@types/pg": "8.16.0",
		"@types/qrcode": "1.5.6",
		"embedded-postgres": "18.4.0-beta.17",
		"esbuild": "0.28.1",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte-check": "4.4.2",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	},
	"overrides": {
		"cookie": "0.7.2",
		"esbuild": "0.28.1"
	},
	"allowScripts": {
		"argon2": true,
		"esbuild": true,
		"@embedded-postgres/linux-x64": true
	}
}
